{
  "name": "nikke-overload-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "npm run deps:prepare && npm run overload:build && npm run cube:build",
    "predev": "npm run deps:prepare",
    "deps:prepare": "node scripts/prepare-og.mjs",
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "postbuild": "node scripts/harden-static-html.mjs",
    "start": "node scripts/run-vinext.mjs start",
    "test": "npm run build && npm run test:static",
    "pretest:static": "npm run deps:prepare",
    "test:static": "node --test tests/rendered-html.test.mjs tests/artwork-check.test.mjs tests/dependency-consistency.test.mjs tests/gear-layout.test.mjs tests/roster-update.test.mjs tests/recommendations-update.test.mjs tests/glob-compat.test.mjs tests/arena-planner.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node --test tests/arena-browser.test.mjs",
    "qa": "npm run build && npm run typecheck && npm run lint && npm run test:static",
    "security:audit": "npm audit --include=dev --audit-level=low",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "artwork:refresh": "node scripts/refresh-artwork.mjs",
    "artwork:check": "node scripts/check-artwork.mjs",
    "overload:build": "node scripts/build-overloads.mjs",
    "cube:build": "node scripts/build-cubes.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-glob": "file:vendor/fast-glob-compat",
    "globals": "16.4.0",
    "playwright-core": "1.64.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.5",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    },
    "vite-plugin-dynamic-import": {
      "fast-glob": "$fast-glob"
    },
    "miniflare": {
      "undici": "7.30.1"
    },
    "@vercel/og": {
      ".": "1.0.3",
      "satori": {
        ".": "0.33.5",
        "fflate": "0.7.5"
      }
    }
  },
  "type": "module"
}

{
  "name": "nikke-overload-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "npm run overload:build",
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "postbuild": "node scripts/harden-static-html.mjs",
    "start": "node scripts/run-vinext.mjs start",
    "test": "npm run build && npm run test:static",
    "test:static": "node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "qa": "npm run build && npm run typecheck && npm run lint && npm run test:static",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "artwork:refresh": "node scripts/refresh-artwork.mjs",
    "artwork:check": "node scripts/check-artwork.mjs",
    "overload:build": "node scripts/build-overloads.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.3",
    "@cloudflare/workers-types": "5.20260812.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vinext": "1.0.0-beta.2",
    "vite": "8.2.1",
    "wrangler": "4.121.0"
  },
  "type": "module"
}

{
  "name": "nikke-overload-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "npm run overload:build && npm run cube:build",
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "postbuild": "node scripts/harden-static-html.mjs",
    "start": "node scripts/run-vinext.mjs start",
    "test": "npm run build && npm run test:static",
    "test:static": "node --test tests/rendered-html.test.mjs tests/artwork-check.test.mjs",
    "typecheck": "tsc --noEmit",
    "qa": "npm run build && npm run typecheck && npm run lint && npm run test:static",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "artwork:refresh": "node scripts/refresh-artwork.mjs",
    "artwork:check": "node scripts/check-artwork.mjs",
    "overload:build": "node scripts/build-overloads.mjs",
    "cube:build": "node scripts/build-cubes.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.10",
    "@cloudflare/workers-types": "5.20260916.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.0.16",
    "wrangler": "4.132.0"
  },
  "type": "module"
}

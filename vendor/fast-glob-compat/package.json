{
  "name": "fast-glob",
  "version": "3.3.3-compat.1",
  "private": true,
  "description": "Scoped synchronous glob adapter for the project's Next ESLint and dynamic-import plugins",
  "type": "commonjs",
  "main": "index.cjs",
  "exports": {
    ".": { "import": "./index.mjs", "require": "./index.cjs" },
    "./package.json": "./package.json"
  },
  "dependencies": { "glob": "13.0.6" },
  "engines": { "node": ">=22.13.0" }
}
